{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pigeon",
  "version": "0.3.0",
  "identifier": "com.intanalytic.pigeon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pigeon",
        "width": 1360,
        "height": 880,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "hover",
        "title": "Pigeon \u2014 live",
        "url": "index.html?surface=hover",
        "width": 322,
        "height": 280,
        "minWidth": 322,
        "minHeight": 280,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A one-view console for your coding agents.",
    "longDescription": "Pigeon reads the sessions Claude Code, Codex and OpenCode already write on this machine, shows what each cost and whether it is waiting on you, and resumes any of them in an embedded terminal. Local-only and read-only."
  }
}
